# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CB_MODEL=claude-sonnet-5      # or claude-opus-5 for the stronger, pricier model
CB_EFFORT=medium            # low | medium | high
CB_SHOW_THINKING=0          # 1 = keep summarized thinking in the transcript

# Content repo (the wiki, .claude/, raw/ and .cb/ state live here)
GITHUB_TOKEN=github_pat_...  # fine-grained PAT: Contents read/write + Metadata read on that repo only
GITHUB_REPO=Guidosalimbeni/cb_wiki_storage
GITHUB_BRANCH=main

# Shared password for the web UI. Leave unset to run open (local dev only).
APP_PASSWORD=

# Local development only: use a local git checkout instead of GitHub.
# CB_LOCAL_REPO=/home/user/cb_wiki_storage

# Stop a run gracefully after this many seconds so it fits Vercel's function limit
# (300s on the Hobby plan with Fluid Compute). The thread is saved and can be continued.
CB_RUN_BUDGET_SECONDS=240
